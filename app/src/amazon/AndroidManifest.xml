<?xml version="1.0" encoding="utf-8"?>
<!-- Amazon Appstore build: no ad SDK and no advertising ID. Firebase Analytics would otherwise
     merge in the advertising-ID / Privacy Sandbox permissions and read the ID, which Amazon's
     review treats as ad tracking (it rejected 3.2.1 for ad-network libraries). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application>
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            tools:node="remove" />
    </application>
</manifest>
