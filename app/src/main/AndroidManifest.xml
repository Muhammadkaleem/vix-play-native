<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 13+ splits media permissions by type: without this the entire audio
         library reads as empty on API 33+, even though READ_EXTERNAL_STORAGE covers it
         below 33. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 14 (API 34) partial media access: the user may grant only selected
         videos ("Select photos and videos"). Declaring this lets that partial grant be a
         first-class state instead of reading as a denial. Visual media only — audio has no
         partial concept. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Legacy write for saving screenshots on API 24–28; scoped storage covers 29+. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Network streaming: reach remote URLs (HTTP/HLS/DASH/RTSP) and report a clean
         offline state rather than a generic failure. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background playback: foreground service + its notification (Android 13+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Daily Briefing: read today's events from the on-device calendar (no OAuth), and
         deliver the morning brief on time. SCHEDULE_EXACT_ALARM is revocable on API 33+;
         the scheduler falls back to an inexact window when it isn't granted. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android TV / Google TV / Fire TV: the same app, driven by a remote. Neither a touchscreen
         nor the TV feature is required, so one APK installs on phones, tablets and TVs. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".VixPlayApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:hasFragileUserData="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VixPlayNative">

        <!-- Cast SDK: receiver app id + session options (Default Media Receiver, no registration). -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.devbytes.vixplayer.app.cast.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:theme="@style/Theme.VixPlayNative.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The TV home screen's app row (Android TV, Google TV, Fire TV); shows the banner. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- ── Open with: well-typed media ──────────────────────────────────
                 Matches any scheme (content/file/http/https) carrying a real video/*
                 or audio/* MIME — Photos, Files, Drive, download managers. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- ── Open with: mistyped content URIs ─────────────────────────────
                 Many file managers hand a .mkv/.avi as application/octet-stream over a
                 content:// URI with no extension in the path, so neither the MIME filter
                 above nor the extension filter below catches them. This does. Deliberately
                 broad (any octet-stream content URI); a genuinely non-media file surfaces
                 the player's clean codec-error overlay rather than crashing. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- ── Open with: by file extension ─────────────────────────────────
                 file:// and http(s):// URIs whose MIME is missing/wrong but whose path
                 ends in a known media extension. No mimeType so null-typed files still
                 match. pathPattern is case-sensitive, so the common extensions carry an
                 uppercase variant too. content:// rarely exposes an extension in-path, so
                 it's covered by the two MIME filters above instead. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\.MKV" />
                <data android:pathPattern=".*\\.avi" />
                <data android:pathPattern=".*\\.AVI" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\.MP4" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\.MOV" />
                <data android:pathPattern=".*\\.m4v" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\.flv" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.m2ts" />
                <data android:pathPattern=".*\\.3gp" />
                <data android:pathPattern=".*\\.ogv" />
                <data android:pathPattern=".*\\.wmv" />
                <data android:pathPattern=".*\\.mpg" />
                <data android:pathPattern=".*\\.mpeg" />
                <data android:pathPattern=".*\\.vob" />
                <data android:pathPattern=".*\\.divx" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\.ape" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\.mka" />
            </intent-filter>

            <!-- ── Share sheet: receive media from other apps ───────────────────-->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Firebase Cloud Messaging: receives push notifications. -->
        <service
            android:name=".notifications.VixMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Defaults the system uses to render FCM notification messages in the background. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_play" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/dark_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="push" />

        <!-- Library Pulse re-engagement notifications: one-tap "turn off" action. -->
        <receiver
            android:name=".notifications.PulseActionReceiver"
            android:exported="false" />

        <!-- Daily Briefing: exact-alarm fire → generation worker. -->
        <receiver
            android:name=".briefing.BriefingAlarmReceiver"
            android:exported="false" />

        <!-- Daily Briefing: re-register the next fire after reboot / time / timezone change. -->
        <receiver
            android:name=".briefing.BriefingBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- On-demand WorkManager init: VixPlayApp is the Configuration.Provider (supplies the
             HiltWorkerFactory), so the default initializer must be removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>