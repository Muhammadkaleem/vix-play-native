<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play build only: AdMob. The Amazon build ships no ad SDK (Amazon rejected 3.2.1 for
     carrying one), so none of this exists there. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Advertising ID: matches the Play Console advertising-ID declaration. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application>
        <!-- AdMob application ID (required by the Google Mobile Ads SDK). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2601730814150494~5767568970" />
    </application>
</manifest>
